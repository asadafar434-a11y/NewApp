NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:8443
DATABASE_URL=postgresql://orbital:orbital@localhost:5432/orbital
BETTER_AUTH_SECRET=change-me-to-a-random-32plus-character-secret
BETTER_AUTH_URL=http://localhost:3000/api/v1/auth
# Обязательны только в production — в dev письма пишутся в лог
UNISENDER_GO_API_KEY=
EMAIL_FROM=no-reply@orbital.ru
# MinIO из docker-compose.yml локально; в проде — S3-совместимое хранилище РФ-провайдера
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=orbital
S3_SECRET_ACCESS_KEY=orbital-local
S3_BUCKET=orbital-uploads
